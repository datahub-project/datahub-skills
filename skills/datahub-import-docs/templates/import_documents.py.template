#!/usr/bin/env python3
"""Import GitHub repo files into DataHub as a hierarchy of Document entities.

Generated by the datahub-import-docs skill. Uses only the stable datahub.sdk
Document API (acryl-datahub >= 1.6.0) — no server-side import resolvers.

The skill fills in DOCUMENTS below from the approved import plan, ordered
parents-first (root → directories → files, shallow → deep), so every
parent_document URN exists before a child references it.

Run:  python3 import_documents.py
"""

from __future__ import annotations

import sys
from pathlib import Path

from datahub.sdk import DataHubClient, Document

# ---------------------------------------------------------------------------
# Configuration (filled in by the skill from the approved plan)
# ---------------------------------------------------------------------------

SOURCE_REMOTE = "<HOST>/<REPO-PATH>"  # e.g. "github.com/acme/handbook"
SOURCE_REF = "<REF>"
SHOW_IN_GLOBAL_CONTEXT = True  # False = AI-only context (reachable via related assets)

# Root directory whose files are being imported. Each document's "path" below is
# relative to this directory.
#   - Local import (preferred): the repo working dir, e.g. `git rev-parse --show-toplevel`.
#   - Remote import: the temp dir of a shallow clone / gh download.
CONTENT_ROOT = Path("<LOCAL_CONTENT_ROOT>")

# Optional mount override. By default repos group under a per-host folder (the first
# DOCUMENTS entry, parent_id=None). Set this to nest that host folder under an existing
# document (e.g. an "Imported Docs" parent), or leave None to mount at the KB root.
TOP_PARENT_URN: str | None = None  # e.g. "urn:li:document:my-knowledge-base"

# Ordered parents-first (host -> repo -> dirs -> files). Each entry:
#   id:               deterministic doc id  -> urn:li:document:<id>
#   title:            display title
#   path:             file path relative to CONTENT_ROOT (None for a synthesized
#                     host/dir/root node that has no backing file -> use `text`)
#   text:             inline body for synthesized nodes (ignored when path is set)
#   parent_id:        parent document id, or None for the top node (mounts under TOP_PARENT_URN)
#   subtype:          optional label (Runbook / FAQ / Reference / ...)
#   related_assets:   optional list of entity URNs
DOCUMENTS: list[dict] = [
    # ids use the host-based namespace from the remote, e.g. "github-com.acme.handbook"
    # (github.com/acme/handbook). GitLab/Bitbucket/self-hosted follow the same shape.
    #
    # Container nodes (host folder, repo-root folder, directory nodes) carry subtype="Folder".
    # Leaf documents get subtype=None (or an opt-in semantic subtype like "Runbook").
    #
    # Host grouping folder (default mount; upserted, reused across imports from this host):
    # {
    #     "id": "github-com",
    #     "title": "github.com",
    #     "path": None,
    #     "text": "Documents imported from github.com repositories.",
    #     "parent_id": None,          # -> mounts under TOP_PARENT_URN, else KB root
    #     "subtype": "Folder",
    #     "related_assets": [],
    # },
    # Repo-root folder (body = root README, or an inline stub via "text" if none exists):
    # {
    #     "id": "github-com.acme.handbook",
    #     "title": "acme/handbook",
    #     "path": "README.md",        # or None + "text": "Imported from github.com/acme/handbook"
    #     "parent_id": "github-com",
    #     "subtype": "Folder",
    #     "related_assets": [],
    # },
    # A leaf document nested under a sub-folder:
    # {
    #     "id": "github-com.acme.handbook.docs.setup",
    #     "title": "Setup",
    #     "path": "docs/setup.md",
    #     "parent_id": "github-com.acme.handbook.docs",
    #     "subtype": None,            # or an opt-in semantic subtype, e.g. "Runbook"
    #     "related_assets": [],
    # },
]

# ---------------------------------------------------------------------------
# Driver (generally not edited by the skill)
# ---------------------------------------------------------------------------


def _urn(doc_id: str) -> str:
    return f"urn:li:document:{doc_id}"


def _body(entry: dict) -> str:
    if entry.get("path"):
        file_path = CONTENT_ROOT / entry["path"]
        # Read as text only; skip on decode errors (caller filtered to text files).
        return file_path.read_text(encoding="utf-8")
    return entry.get("text") or ""


def main() -> int:
    client = DataHubClient.from_env()

    created = updated = failed = 0
    failures: list[tuple[str, str]] = []

    for entry in DOCUMENTS:
        doc_id = entry["id"]
        try:
            # Resolve parent: explicit parent_id wins; else nest under TOP_PARENT_URN
            # only for root-level entries.
            if entry.get("parent_id"):
                parent_urn = _urn(entry["parent_id"])
            else:
                parent_urn = TOP_PARENT_URN

            custom_props = {
                "source_remote": SOURCE_REMOTE,
                "source_ref": SOURCE_REF,
            }
            if entry.get("path"):
                custom_props["source_path"] = entry["path"]

            doc = Document.create_document(
                id=doc_id,
                title=entry["title"],
                text=_body(entry),
                show_in_global_context=SHOW_IN_GLOBAL_CONTEXT,
                subtype=entry.get("subtype"),
                parent_document=parent_urn,
                related_assets=entry.get("related_assets") or None,
                custom_properties=custom_props,
            )

            # Idempotent: create if absent, update in place if present.
            client.entities.upsert(doc)

            # Best-effort create/update accounting for the report.
            action = entry.get("_action", "upsert")
            if action == "update":
                updated += 1
            else:
                created += 1
            print(f"OK    {action:<6} {_urn(doc_id)}")
        except Exception as exc:  # continue-on-error; report at the end
            failed += 1
            reason = str(exc).splitlines()[0][:160] if str(exc) else type(exc).__name__
            failures.append((doc_id, reason))
            print(f"FAIL  {_urn(doc_id)}  -> {reason}", file=sys.stderr)

    print("\n--- Import summary ---")
    print(f"attempted={len(DOCUMENTS)} created={created} updated={updated} failed={failed}")
    if failures:
        print("failures:")
        for doc_id, reason in failures:
            print(f"  {doc_id}: {reason}")

    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
